{
  "name": "tandemcommander-web",
  "version": "0.1.0",
  "private": true,
  "description": "Website for Tandem Commander, an open source two-pane file manager. Hosted on Cloudflare Workers.",
  "license": "MIT",
  "scripts": {
    "build": "node -e \"fs.rmSync('public',{recursive:true,force:true})\" && eleventy",
    "dev": "eleventy --serve",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run build && wrangler deploy --dry-run",
    "test": "node --test \"tests/**/*.test.js\"",
    "release:facts": "node tools/release/release.mjs facts",
    "release:apply": "node tools/release/release.mjs apply",
    "release:check": "node tools/release/release.mjs check",
    "shots": "node tools/screenshots/capture.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@fontsource/archivo": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.4",
    "wrangler": "^4.0.0"
  }
}
