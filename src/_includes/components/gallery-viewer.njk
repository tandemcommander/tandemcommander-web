{#- The viewer is PhotoSwipe (self-hosted, MIT); this element only carries the
    strings its interface needs, so nothing user-visible lives in the script. -#}
<span class="visually-hidden" data-gallery-strings
      data-close-title="{{ lang | t("gallery.viewerClose") }}"
      data-prev-title="{{ lang | t("gallery.viewerPrev") }}"
      data-next-title="{{ lang | t("gallery.viewerNext") }}"
      data-zoom-title="{{ lang | t("gallery.viewerZoom") }}"
      data-fullscreen-title="{{ lang | t("gallery.viewerFullscreen") }}"
      data-error-msg="{{ lang | t("gallery.viewerError") }}"></span>
