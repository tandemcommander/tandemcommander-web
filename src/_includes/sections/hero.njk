<section id="top" class="hero">
  <div class="hero-inner">
    <div class="hero-lockup">
      <img src="/assets/tandem-commander-lockup-light.svg" alt="{{ lang | t("hero.lockupAlt") }}" class="lockup lockup--light">
      <img src="/assets/tandem-commander-lockup-dark.svg" alt="" aria-hidden="true" class="lockup lockup--dark">
    </div>
    <h1 class="hero-title">{{ lang | t("hero.title") | safe }}</h1>
    <p class="hero-lead">{{ lang | t("hero.lead") }}</p>
    <div class="hero-cta">
      <a href="#download" class="btn btn--primary">{{ lang | t("hero.ctaDownload") }}<span class="btn-badge">v{{ site.version }}</span></a>
      <a href="{{ site.github.repoUrl }}" class="btn btn--secondary">{{ lang | t("hero.ctaSource") }}</a>
    </div>
    <p class="hero-note">{{ lang | t("hero.note") }}</p>
  </div>
</section>
