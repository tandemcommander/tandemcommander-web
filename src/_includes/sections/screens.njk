<section id="screens" class="section">
  <div class="section-inner">
    <div class="section-head">
      <p class="kicker">Two themes, one binary</p>
      <h2 class="section-title">Light by default. Dark when you want it.</h2>
      <p class="section-lead">The classic light panels are still the default — nothing moved, nothing was reflowed. The new dark theme is the same layout with the same information density, for the people who stopped enjoying white rectangles at 2 a.m. It is still experimental — a few places are not quite final yet.</p>
    </div>
    <div class="screens-grid">
      <figure class="shot">
        <figcaption class="shot-caption">
          <span class="swatch swatch--light"></span>
          <span class="shot-label">Light</span>
          <span class="shot-note">— the default, unchanged</span>
        </figcaption>
        <div class="shot-frame">
          <img src="/assets/screenshot-light.png" alt="Tandem Commander in its light theme, two file panels side by side">
        </div>
      </figure>
      <figure class="shot">
        <figcaption class="shot-caption">
          <span class="swatch swatch--dark"></span>
          <span class="shot-label">Dark</span>
          <span class="shot-note">— new in {{ site.version }}</span>
        </figcaption>
        <div class="shot-frame">
          <img src="/assets/screenshot-dark.png" alt="Tandem Commander in its dark theme, the same two panels">
        </div>
      </figure>
    </div>
  </div>
</section>
