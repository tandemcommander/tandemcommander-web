<section id="screens" class="section">
  <div class="section-inner">
    <div class="section-head">
      <p class="kicker">{{ lang | t("screens.kicker") }}</p>
      <h2 class="section-title">{{ lang | t("screens.title") }}</h2>
      <p class="section-lead">{{ lang | t("screens.lead") }}</p>
    </div>
    <div class="screens-grid">
      <figure class="shot">
        <figcaption class="shot-caption">
          <span class="swatch swatch--light"></span>
          <span class="shot-label">{{ lang | t("screens.lightLabel") }}</span>
          <span class="shot-note">{{ lang | t("screens.lightNote") }}</span>
        </figcaption>
        <div class="shot-frame">
          <button type="button" class="shot-zoom" aria-label="{{ lang | t("screens.zoomLabel") }}">
            <img src="/assets/screenshot-light.png" alt="{{ lang | t("screens.lightAlt") }}">
            <span class="shot-zoom-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <circle cx="10.5" cy="10.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="M14.8 14.8L19 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
        </div>
      </figure>
      <figure class="shot">
        <figcaption class="shot-caption">
          <span class="swatch swatch--dark"></span>
          <span class="shot-label">{{ lang | t("screens.darkLabel") }}</span>
          <span class="shot-note">{{ lang | t("screens.darkNote") | replace("{version}", site.version) }}</span>
        </figcaption>
        <div class="shot-frame">
          <button type="button" class="shot-zoom" aria-label="{{ lang | t("screens.zoomLabel") }}">
            <img src="/assets/screenshot-dark.png" alt="{{ lang | t("screens.darkAlt") }}">
            <span class="shot-zoom-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <circle cx="10.5" cy="10.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="M14.8 14.8L19 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
        </div>
      </figure>
    </div>
    <dialog class="lightbox" aria-label="{{ lang | t("screens.lightboxLabel") }}">
      <button type="button" class="lightbox-close" aria-label="{{ lang | t("screens.lightboxClose") }}">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <img class="lightbox-img" src="" alt="">
    </dialog>
  </div>
</section>
