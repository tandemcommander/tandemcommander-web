{% set installerFile = installer.fileName %}
{% set installerUrl = installer.url %}
{% set locale = lang | locale %}
<section id="download" class="section section--download">
  <div class="download-inner">
    <img src="/assets/tandem-commander-icon.svg" alt="" aria-hidden="true" class="download-mark">
    <h2 class="section-title section-title--md">{{ lang | t("download.heading") | replace("{version}", site.version) }}</h2>
    <div class="installer-wrap">
      <div class="installer-card">
        <h3 class="installer-title">{{ lang | t("download.installerTitle") }}</h3>
        <p class="installer-desc">{{ lang | t("download.installerDesc") | replace("{version}", site.version) }}<br>{{ lang | t("download.installerReleased") | replace("{date}", site.releaseDate | releaseDate(locale.intl)) }}</p>
        <a href="{{ installerUrl }}" class="btn btn--primary btn--download"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="M6.5 10.5 12 16l5.5-5.5"></path><path d="M4 20h16"></path></svg>{{ lang | t("download.installerButton") }}</a>
        <p class="installer-file">{{ installerFile }}</p>
      </div>
    </div>
    <p class="download-meta">{{ lang | t("download.meta") }} · <a href="{{ site.github.releasesUrl }}">{{ lang | t("download.metaAllReleases") }}</a> · <a href="{{ site.github.issuesUrl }}">{{ lang | t("download.metaReportIssue") }}</a></p>
    <div class="disclaimer">
      <p class="disclaimer-label">{{ lang | t("download.disclaimerLabel") }}</p>
      <p class="disclaimer-text">{{ lang | t("download.disclaimerText") }}</p>
    </div>
    <div class="build-box">
      <p class="build-label">{{ lang | t("download.buildLabel") }}</p>
      <div class="build-lines">
        <div><span class="code-cmd">git</span> clone {{ site.github.repoUrl }}.git</div>
        <div><span class="code-cmd">build.cmd</span> full release<span class="code-comment">    {{ lang | t("download.buildComment") }}</span></div>
      </div>
    </div>
  </div>
</section>
