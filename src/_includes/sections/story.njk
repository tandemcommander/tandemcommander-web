<section id="story" class="section section--roomy section--divided">
  <div class="story-inner">
    <p class="kicker">{{ lang | t("story.kicker") }}</p>
    <h2 class="section-title section-title--md">{{ lang | t("story.title") }}</h2>
    <p class="story-text">{{ lang | t("story.p1") }}</p>
    <p class="story-text">{{ lang | t("story.p2") }}</p>
    <p class="story-text">{{ lang | t("story.p3") | safe }}</p>
    <p class="story-text">{{ lang | t("story.p4") }}</p>
    <p class="story-text story-text--flush">{{ lang | t("story.p5") | safe }}</p>
    <p class="story-signature">{{ site.author.name }}<br><a href="mailto:{{ site.author.email }}" class="story-mail">{{ site.author.email }}</a><br><a href="{{ site.author.linkedin }}" class="story-mail">{{ lang | t("story.signatureLinkedin") }}</a></p>
  </div>
</section>
