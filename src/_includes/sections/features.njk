<section class="section band">
  <div class="section-inner">
    <div class="section-head">
      <p class="kicker">{{ lang | t("features.kicker") }}</p>
      <h2 class="section-title">{{ lang | t("features.title") }}</h2>
      <p class="section-lead">{{ lang | t("features.lead") }}</p>
    </div>
    <div class="card-grid card-grid--features">
      <article class="card">
        <p class="card-num">01</p>
        <h3 class="card-title">{{ lang | t("features.card1Title") }}</h3>
        <p class="card-text">{{ lang | t("features.card1Text") }}</p>
      </article>
      <article class="card">
        <p class="card-num">02</p>
        <h3 class="card-title">{{ lang | t("features.card2Title") }}</h3>
        <p class="card-text">{{ lang | t("features.card2Text") }}</p>
      </article>
      <article class="card card--accent">
        <p class="card-num card-num--brand">03</p>
        <h3 class="card-title">{{ lang | t("features.card3Title") }}</h3>
        <p class="card-text">{{ lang | t("features.card3Text") | safe }}</p>
      </article>
    </div>
  </div>
</section>
