<section id="project" class="section band section--roomy">
  <div class="section-inner project-grid">
    <div>
      <p class="kicker">{{ lang | t("project.kicker") }}</p>
      <h2 class="section-title">{{ lang | t("project.title") }}</h2>
      <p class="project-text">{{ lang | t("project.text1") | safe }}</p>
      <p class="project-text">{{ lang | t("project.text2") | safe }}</p>
      <p class="project-text">{{ lang | t("project.text3") }}</p>
      <div class="agentic-note">
        <p class="project-text project-text--flush">{{ lang | t("project.agenticNote") }}</p>
      </div>
    </div>
    <div class="facts">
      <div class="fact">
        <span class="fact-label">{{ lang | t("project.factVersion") }}</span>
        <span class="fact-value">{{ site.version }}</span>
      </div>
      <div class="fact">
        <span class="fact-label">{{ lang | t("project.factPlatform") }}</span>
        <span class="fact-value">{{ site.platform }}</span>
      </div>
      <div class="fact">
        <span class="fact-label">{{ lang | t("project.factLicense") }}</span>
        <span class="fact-value">{{ site.license }}</span>
      </div>
      <div class="fact">
        <span class="fact-label">{{ lang | t("project.factToolchain") }}</span>
        <span class="fact-value">{{ site.toolchain }}</span>
      </div>
    </div>
  </div>
</section>
