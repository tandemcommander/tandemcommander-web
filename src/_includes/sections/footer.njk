<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div>
        <div class="brand brand--footer">
          <img src="/assets/tandem-commander-icon.svg" alt="" aria-hidden="true" class="brand-mark">
          <span class="brand-name">Tandem <span class="brand-accent">Commander</span></span>
        </div>
        <p class="footer-tagline">A fast, keyboard-friendly two-pane file manager for Windows.</p>
      </div>
      <div class="footer-col">
        <p class="footer-heading">Program</p>
        <a href="#screens" class="footer-link">Themes</a>
        <a href="#new" class="footer-link">What's new</a>
        <a href="#project" class="footer-link">Project</a>
        <a href="#download" class="footer-link">Download</a>
      </div>
      <div class="footer-col">
        <p class="footer-heading">Source</p>
        <a href="{{ site.github.repoUrl }}" class="footer-link">GitHub</a>
        <a href="{{ site.github.issuesUrl }}" class="footer-link">Issues</a>
        <a href="https://www.gnu.org/licenses/old-licenses/gpl-2.0.html" class="footer-link">GPLv2 licence</a>
      </div>
      <div class="footer-col">
        <p class="footer-heading">Contact</p>
        <span class="footer-plain">{{ site.author.name }}</span>
        <a href="mailto:{{ site.author.email }}" class="footer-link">{{ site.author.email }}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-legal">{{ site.domain }} · {{ site.license }}</p>
      <p class="footer-note">Free software, built in the open. Issues and pull requests are welcome.</p>
    </div>
  </div>
</footer>
