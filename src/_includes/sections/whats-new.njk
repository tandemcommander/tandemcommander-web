<section id="new" class="section section--roomy">
  <div class="section-inner">
    <div class="section-head">
      <p class="kicker">{{ lang | t("whatsNew.kicker") }}</p>
      <h2 class="section-title">{{ lang | t("whatsNew.title") }}</h2>
      <p class="section-lead">{{ lang | t("whatsNew.lead") }}</p>
    </div>
    <div class="card-grid card-grid--news">
      <article class="card card--accent card--tight">
        <h3 class="card-title card-title--sm">{{ lang | t("whatsNew.entry1Title") }}</h3>
        <p class="card-text card-text--sm">{{ lang | t("whatsNew.entry1Text") }}</p>
      </article>
      <article class="card card--accent card--tight">
        <h3 class="card-title card-title--sm">{{ lang | t("whatsNew.entry2Title") }}</h3>
        <p class="card-text card-text--sm">{{ lang | t("whatsNew.entry2Text") | safe }}</p>
      </article>
      <article class="card card--accent card--tight">
        <h3 class="card-title card-title--sm">{{ lang | t("whatsNew.entry3Title") }}</h3>
        <p class="card-text card-text--sm">{{ lang | t("whatsNew.entry3Text") | safe }}</p>
      </article>
      <article class="card card--accent card--tight">
        <h3 class="card-title card-title--sm">{{ lang | t("whatsNew.entry4Title") }}</h3>
        <p class="card-text card-text--sm">{{ lang | t("whatsNew.entry4Text") }}</p>
      </article>
    </div>
  </div>
</section>
